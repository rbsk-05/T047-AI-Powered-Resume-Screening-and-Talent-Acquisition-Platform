# Change this to your local PostgreSQL database once it has been created.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/resume_screening
APP_NAME=TalentLens AI
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# --- AI layer ---
# Embeddings: on by default. First use downloads the model from
# huggingface.co, so it needs internet access once. If it can't load for any
# reason, Module 3 automatically falls back to lexical (Jaccard) matching.
ENABLE_EMBEDDINGS=true
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# LLM extraction/explanation: off by default. Turn on once you have a Groq API key.
# Get a free key at: https://console.groq.com
# Available models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
ENABLE_LLM_EXTRACTION=false
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# --- Authentication ---
# Generate a real random value for local/production use, e.g. run:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never commit a real secret to source control.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
